// Schema do Delivery Tracker (Cap. 5 — Prisma + SQLite).
// Gere/aplique as migrations com: npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Status são texto (CRIADA, EM_TRANSITO, ENTREGUE, CANCELADA / ATIVO, INATIVO);
// os valores válidos são garantidos pelos services.

model Motorista {
  id           Int       @id @default(autoincrement())
  nome         String
  cpf          String    @unique
  placaVeiculo String?
  status       String    @default("ATIVO")
  entregas     Entrega[]

  @@map("motoristas")
}

model Entrega {
  id          Int        @id @default(autoincrement())
  descricao   String
  origem      String
  destino     String
  status      String     @default("CRIADA")
  motoristaId Int?
  motorista   Motorista? @relation(fields: [motoristaId], references: [id])
  historico   Evento[]

  @@index([status])
  @@index([motoristaId])
  @@map("entregas")
}

// Cada item do histórico de uma entrega.
model Evento {
  id        Int      @id @default(autoincrement())
  data      DateTime
  descricao String
  entregaId Int
  entrega   Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)

  @@index([entregaId])
  @@map("eventos")
}
