<div class="cabecalho">
  <h1>Motoristas</h1>
  <a href="/motoristas/novo" class="botao">Novo Motorista</a>
</div>

<div class="tabela-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Nome</th>
        <th>CPF</th>
        <th>Placa</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (motoristas.length === 0) { %>
        <tr><td colspan="6" class="vazio">Nenhum motorista cadastrado.</td></tr>
      <% } %>
      <% motoristas.forEach((motorista) => { %>
        <tr>
          <td><%= motorista.id %></td>
          <td><%= motorista.nome %></td>
          <td><%= motorista.cpf %></td>
          <td><%= motorista.placaVeiculo ?? '—' %></td>
          <td><%- include('../partials/badge', { status: motorista.status }) %></td>
          <td><a href="/motoristas/<%= motorista.id %>">Entregas</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
