<a href="/motoristas" class="voltar">← Voltar para motoristas</a>

<div class="cabecalho">
  <h1><%= motorista.nome %></h1>
  <%- include('../partials/badge', { status: motorista.status }) %>
</div>

<section class="cartao">
  <dl class="dados">
    <dt>CPF</dt><dd><%= motorista.cpf %></dd>
    <dt>Placa</dt><dd><%= motorista.placaVeiculo ?? '—' %></dd>
  </dl>
</section>

<h2>Entregas atribuídas</h2>
<div class="tabela-wrapper">
  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Descrição</th>
        <th>Origem</th>
        <th>Destino</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (entregas.length === 0) { %>
        <tr><td colspan="6" class="vazio">Nenhuma entrega atribuída a este motorista.</td></tr>
      <% } %>
      <% entregas.forEach((entrega) => { %>
        <tr>
          <td><%= entrega.id %></td>
          <td><%= entrega.descricao %></td>
          <td><%= entrega.origem %></td>
          <td><%= entrega.destino %></td>
          <td><%- include('../partials/badge', { status: entrega.status }) %></td>
          <td><a href="/entregas/<%= entrega.id %>">Detalhes</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
